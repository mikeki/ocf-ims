# The comments and defaults in this file assume you're a developer
# wanting to run IMS locally.

# Standard dev settings that you probably don't need to touch.
IMS_HOSTNAME="localhost"
IMS_PORT=8080
IMS_LOG_LEVEL="DEBUG"
IMS_DEPLOYMENT="Dev"
IMS_TOKEN_LIFETIME=604800
IMS_CACHE_CONTROL_SHORT="0s"
IMS_CACHE_CONTROL_LONG="0s"

# Administrators are managed in-app via the PERSON.IS_ADMIN flag (toggle from
# Admin → People & Passwords) — there is no admin env list. The dev seed
# (store/fakeimsdb/seed.sql) marks Miguel as an admin; for a fresh production DB the
# operator seeds the first admin by inserting a PERSON row with IS_ADMIN = true
# (password hashed via the hash_password CLI).

# The user directory is the local IMS-DB PERSON table. For dev it is seeded from
# store/fakeimsdb/seed.sql, where you can log in as any seeded person
# (password == handle), e.g. hardware@example.com with password Hardware.

# JWT secret is used as the signing key for refresh and access tokens.
# If it's unset, IMS will generate a new random secret on startup.
# It's better to generate a random string once and put that here, e.g.
# with `openssl rand -hex 32` or `uuidgen`, so you won't have to log
# into IMS every time you restart the server.
# Non-dev deployments (IMS_DEPLOYMENT != dev) REQUIRE a secret of at least
# 32 characters — the server refuses to start otherwise.
# IMS_JWT_SECRET="e771ca4792436915900ea62d240ad089ab12cd34ef56ab78cd90ef12ab34cd56"

# Failed-login throttling on POST /ims/api/auth: per-IP and per-account
# backoff + temporary lockout after repeated failures (protects against online
# password guessing and login-flood DoS). Enabled by default; set to "false"
# only for local testing where you're deliberately hammering the auth endpoint.
# IMS_LOGIN_RATE_LIMIT_ENABLED="true"

# Leave this as "fake" to run an in-process, volatile IMS database.
# You can prepopulate this database via store/fakeimsdb/seed.sql
IMS_DB_STORE_TYPE="fake"

# Or, you can use a full MariaDB instance, which is what we do for
# the "real" IMS instances. You'll also need to set the IMS_DB_*
# variables below in this case.
# IMS_DB_STORE_TYPE="MariaDB"

# # IMS MariaDB settings
# IMS_DB_HOST_NAME="localhost"
# IMS_DB_HOST_PORT=3306
# IMS_DB_DATABASE="ims"
# IMS_DB_USER_NAME="ims"
# # Pick something random, e.g. by `openssl rand -hex 16`
# IMS_DB_PASSWORD="94ad21cc597277db1f4211bd93f4dcbf"

# Choose how to handle attachments. Pick one or neither of these. S3 requires
# additional configuration.
# IMS_ATTACHMENTS_STORE="local"
# IMS_ATTACHMENTS_STORE="s3"

# Required when using "local" attachments store.
# This can be an absolute path, or relative to the directory from which you
# run the IMS server.
IMS_ATTACHMENTS_LOCAL_DIR="ims-attachments"

# Required when using "s3" attachments store.
# AWS_ACCESS_KEY_ID="my access key from AWS"
# AWS_SECRET_ACCESS_KEY="my secret access key from AWS"
# AWS_REGION="my bucket's region"
# IMS_ATTACHMENTS_S3_BUCKET="my bucket name"
# IMS_ATTACHMENTS_S3_COMMON_KEY_PREFIX="ims-dev-attachments/"

# Web push notifications (plan 84). Leave unset to disable push (the dev default);
# the client then never advertises the feature. To enable, set all three: a
# self-generated VAPID key pair (the private key is a SECRET — never commit it)
# and a mailto:/https: contact required by the push spec. Push also needs the
# server to be HTTPS in production (service workers require a secure context).
# IMS_VAPID_PUBLIC="your VAPID public key"
# IMS_VAPID_PRIVATE="your VAPID private key (secret)"
# IMS_VAPID_SUBJECT="mailto:ims@example.org"
