{
  "expo": {
    "name": "OCF IMS",
    "slug": "ocf-ims",
    "version": "0.1.0",
    "scheme": "ocfims",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2457A6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow OCF IMS to use the camera to photograph an incident.",
          "photosPermission": "Allow OCF IMS to choose a photo from your library to attach to an incident.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
