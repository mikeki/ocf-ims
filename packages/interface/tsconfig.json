{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 no longer includes every @types/* package automatically;
    // the Jest globals (describe / it / expect) in __tests__ need this one.
    // Playwright and React Native Testing Library are imported explicitly.
    "types": ["jest"]
  },
  "exclude": ["node_modules", "dist", "jest.config.js", "android", "ios"]
}
