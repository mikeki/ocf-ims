// SPDX-License-Identifier: Apache-2.0

package template

templ Root(deployment, versionName, versionRef string) {
<!DOCTYPE html>
<html lang="en">
@Head("Home | IMS", "root.js", false, false, versionRef)

<body>
<div class="container-fluid">
@Header(deployment)
@Nav("")
<h1 id="doc-title">Incident Management System</h1>

@ErrorInfo()

<p class="mt-3 if-logged-in hidden">
  <a id="current-year-link" href="/ims/app/events/2026/incidents">Jump to the current event</a> or select another event from the dropdown above.
</p>

<div class="mt-3">
  <p>
    The OCF Incident Management System is where Oregon Country Fair Volunteers and
    coordinators log, track, and follow up on incidents and field reports during
    the Fair. Use it to record what happened, who was involved, and what was done.
  </p>
</div>

<div class="btn-group mb-3" role="group">
  <a
     id="login-button"
     href="/ims/auth/login"
     role="button"
     class="btn btn-md btn-default btn-primary if-not-logged-in hidden"
  >
    Log In
  </a>
</div>

<div class="btn-group mb-3" role="group">
  <a
     href="/ims/auth/logout"
     role="button"
     class="btn btn-md btn-default btn-danger if-logged-in hidden"
  >
    Log Out
  </a>
</div>
@Footer(versionName, versionRef)
</div>
</body>
</html>
}
