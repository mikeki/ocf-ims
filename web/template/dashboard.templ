package template

templ Dashboard(deployment, versionName, versionRef, eventName string) {
<!DOCTYPE html>
<html lang="en">
@Head("Dashboard | "+eventName, "dashboard.js", false, true, versionRef)

<body>
<div class="container-fluid">
@Header(deployment)
@Nav(eventName)
<h1 id="doc-title">Dashboard</h1>
@LoadingOverlay()
@ErrorInfo()

  <!-- Refresh controls -->
  <div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="dashboard_toolbar">
    <button type="button" class="btn btn-sm btn-outline-secondary" id="refresh_button">Refresh</button>
    <div class="d-flex align-items-center gap-1">
      <label for="auto_refresh_interval" class="form-label mb-0 small text-body-secondary">Auto-refresh</label>
      <select id="auto_refresh_interval" class="form-select form-select-sm w-auto" aria-label="Auto-refresh interval">
        <option value="0">Off</option>
        <option value="30">Every 30s</option>
        <option value="60">Every 1m</option>
        <option value="300">Every 5m</option>
      </select>
    </div>
    <span class="text-body-secondary small ms-sm-auto" id="last_updated">Last updated: —</span>
  </div>

  <!-- Headline counts -->
  <div class="row g-3 mb-3" id="summary_cards">
    <div class="col-6 col-md-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <div class="fs-2 fw-bold" id="stat_total">—</div>
          <div class="text-body-secondary">Incidents</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <div class="fs-2 fw-bold" id="stat_open">—</div>
          <div class="text-body-secondary">Open</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <div class="fs-2 fw-bold" id="stat_closed">—</div>
          <div class="text-body-secondary">Closed</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-center h-100">
        <div class="card-body">
          <div class="fs-2 fw-bold" id="stat_avg_close">—</div>
          <div class="text-body-secondary">Avg. time to close (<span id="stat_avg_close_n">0</span>)</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Status overview: state + priority -->
  <div class="row g-3 mb-3">
    <div class="col-12 col-lg-6">
      <div class="card h-100">
        <div class="card-header">By state</div>
        <div class="card-body"><canvas id="chart_state" height="220"></canvas></div>
      </div>
    </div>
    <div class="col-12 col-lg-6">
      <div class="card h-100">
        <div class="card-header">By priority</div>
        <div class="card-body"><canvas id="chart_priority" height="220"></canvas></div>
      </div>
    </div>
  </div>

  <!-- Category + type. The counts can exceed the incident total: an incident
       with several types lands in several categories/types. -->
  <div class="row g-3 mb-3">
    <div class="col-12 col-lg-5">
      <div class="card h-100">
        <div class="card-header">
          By category
          <span class="text-body-secondary small">— counts may exceed total (multi-type)</span>
        </div>
        <div class="card-body"><canvas id="chart_category" height="260"></canvas></div>
      </div>
    </div>
    <div class="col-12 col-lg-7">
      <div class="card h-100">
        <div class="card-header">By type</div>
        <div class="card-body"><canvas id="chart_type" height="260"></canvas></div>
      </div>
    </div>
  </div>

  <!-- Areas: chart + repeat-locations ranking -->
  <div class="row g-3 mb-3">
    <div class="col-12 col-lg-7">
      <div class="card h-100">
        <div class="card-header">By area</div>
        <div class="card-body"><canvas id="chart_area" height="260"></canvas></div>
      </div>
    </div>
    <div class="col-12 col-lg-5">
      <div class="card h-100">
        <div class="card-header">Busiest locations</div>
        <div class="card-body p-0">
          <table class="table table-striped table-sm mb-0">
            <thead>
              <tr><th>Area</th><th class="text-end">Incidents</th></tr>
            </thead>
            <tbody id="area_table_body">
              <template id="area_row_template">
                <tr><td class="area-name"></td><td class="area-count text-end"></td></tr>
              </template>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Incidents created per day -->
  <div class="row g-3 mb-3">
    <div class="col-12">
      <div class="card">
        <div class="card-header">Incidents created per day</div>
        <div class="card-body"><canvas id="chart_byday" height="120"></canvas></div>
      </div>
    </div>
  </div>

  <!-- Open follow-ups -->
  <div class="row g-3 mb-3">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          Open follow-ups
          <span class="badge text-bg-secondary ms-1" id="followups_count">0</span>
        </div>
        <div class="card-body p-0">
          <table class="table table-striped table-sm mb-0">
            <thead>
              <tr><th><abbr title="IMS#">#</abbr></th><th>Summary</th></tr>
            </thead>
            <tbody id="followups_table_body">
              <template id="followup_row_template">
                <tr>
                  <td><a class="followup-link" href=""></a></td>
                  <td class="followup-summary"></td>
                </tr>
              </template>
            </tbody>
          </table>
          <p id="followups_empty" class="text-body-secondary small m-2 hidden">No open follow-ups.</p>
        </div>
      </div>
    </div>
  </div>

@Footer(versionName, versionRef)
</div>
</body>
</html>

}
