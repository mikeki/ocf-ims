package template

templ Report(deployment, versionName, versionRef, eventName string) {
<!DOCTYPE html>
<html lang="en">
@Head("Report Details | " + eventName, "report.js", false, false, versionRef)

<body>
<div class="container-fluid">
@Header(deployment)
@Nav(eventName)
<h1 id="doc-title">Report Details</h1>

@LoadingOverlay()

@ErrorInfo()

@QuickAddPersonModal()

  <!-- Help modal for report page -->
  <div class="modal no-print" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <p class="modal-title fs-5" id="helpModalLabel">Keyboard shortcuts</p>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
        </div>
        <div class="modal-body">
          <code>n</code>: create (n)ew Report <br/>
          <code>a</code>: jump to (a)dd new journal text<br/>
          <code>h</code>: toggle showing system-generated (h)istory <br/>
        </div>
      </div>
    </div>
  </div>

  <!-- Identifiers -->

  <div class="row py-1">
    <div class="col-sm-4" id="report_number_field">
      <div class="py-1 input-group">
        <label for="report_number" class="control-label input-group-text">Report #</label>
        <input
            id="report_number" type="text" aria-label="Report #"
            class="form-control form-control-static" readonly/>
      </div>
    </div>
    <div class="col-sm-4" id="incident_number_field">
      <div class="py-1 input-group">
        <a id="incident_number_link" href="#" class="control-label input-group-text">IMS #</a>
        <input
            id="incident_number" aria-label="IMS #" type="text" class="form-control form-control-static input-sm"
            onchange="updateIncident(this);" readonly
        />
      </div>
    </div>
    <div class="col-sm-4">
      <div class="py-1">
        <button
            id="create_incident"
            class="py-1 btn btn-sm btn-warning hidden"
            title="Only click this if you're sure there is no preexisting incident for this Report. This only shows up because you have writeIncidents permission."
            onclick="makeIncident()"
        >
          Create new incident from Report
        </button>
      </div>
    </div>
  </div>

  <!-- Reporter / Submitter (6m) -->

  <div class="row py-1">
    <div class="col-sm-6" id="reporter_field">
      <div class="py-1 input-group position-relative">
        <label for="reporter_add" class="control-label input-group-text">Reporter</label>
        <input
                id="reporter_add" type="text" aria-label="Reporter"
                autocomplete="off"
                class="form-control input-sm" readonly
        />
        <!-- Person typeahead dropdown (shown only on a new report); populated by ims.ts. -->
        <div id="reporter_add_results"
             class="list-group position-absolute w-100 shadow hidden no-print"
             style="z-index: 1080; top: 100%; max-height: 14rem; overflow-y: auto;"></div>
      </div>
    </div>
    <div class="col-sm-6">
      <div class="py-1 input-group">
        <label for="submitter_display" class="control-label input-group-text">Submitter</label>
        <input
                id="submitter_display" type="text" aria-label="Submitter"
                class="form-control form-control-static input-sm" readonly
        />
      </div>
    </div>
  </div>

  <!-- Summary -->

  <div class="row">
    <div class="col-sm-12">
      <div class="py-1 input-group">
        <label for="report_summary" class="control-label input-group-text">Summary</label>
        <input
                id="report_summary" class="form-control input-sm"
                type="text" inputmode="latin-prose" autocomplete="off"
                onchange="editSummary()"
        />
      </div>
    </div>
  </div>

  <!-- Instructions -->

  <div class="row no-print">
    <div class="accordion px-4 py-1" id="instructions">
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button id="fr-instructions" class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                  data-bs-target="#verboseInstructions" aria-expanded="false"
                  aria-controls="verboseInstructions">
            How to write a great Report
          </button>
        </h2>
        <div id="verboseInstructions" class="accordion-collapse collapse text-smaller p-1"
             data-bs-parent="#instructions">
          <p>
            Start above with a brief Summary, then scroll down to Details and enter a thorough account of what happened.
          </p>

          <p>
            Please include the following information:
          </p>
          <ul>
            <li>Time and date of incident</li>
            <li>Location of incident</li>
            <li>Name of report author, if you are entering a report for someone else</li>
            <li>Names of others present at the incident</li>
            <li>Identifying information for law enforcement and other officials:</li>
            <ul>
              <li>Agency (Sheriff, police, fire/medical, etc.)</li>
              <li>Badge numbers</li>
              <li>Vehicle identifiers (plate/window numbers, make/model, color, etc.)</li>
            </ul>
          </ul>

          <p>
            <strong>Please stick to facts:</strong>
          </p>
          <ul>
            <li>Do not write about what you think may have happened; just write about what you did, saw and
              heard yourself.
            </li>
            <li>Do include things that people told you, but be sure to note who said what.</li>
            <li>It is important to distinguish what you are saying from what you heard others say.</li>
          </ul>

          <p>
            Write everything you can remember, in as much detail as possible.
            Don't worry about your report being too long, but be clear and concise.
            Avoid jargon and acronyms.
          </p>

          <p>
            <strong>Be sure to save your report.</strong>
            Click on "Submit" to save your journal entry.
            Once you have saved, you cannot edit the saved entry, but you can still add additional entries.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Report details -->

  <div class="row py-1">
    <div class="col-sm-12">
      <div class="card">
        <label class="control-label card-header">Details</label>
        <div id="journal_entry_well" class="card-body">
          <label class="control-label" id="history_toggle">
            <input id="history_checkbox" type="checkbox" onchange="toggleShowHistory()"/>
            Show history and stricken
          </label>
          <div id="journal_entries"></div>
          <div class="card-footer">
            <div class="position-relative">
              <textarea
                      id="journal_entry_add"
                      aria-label="New journal entry text"
                      class="form-control no-print input-sm"
                      placeholder="Press &quot;a&quot; to add journal text. Type @ to mention someone."
                      onchange="journalEntryEdited()"
              ></textarea>
              <!-- @mention typeahead dropdown (plan 81); populated by ims.ts. -->
              <div id="journal_mention_results"
                   class="list-group position-absolute w-100 shadow hidden no-print"
                   style="z-index: 1080; max-height: 14rem; overflow-y: auto;"></div>
            </div>
            <span id="journal_draft_restored" class="text-body-secondary small hidden no-print">Unsaved draft restored.</span>
            <div class="d-flex justify-content-between">
              <div class="btn-group my-1 no-print" role="group">
                <button
                        id="journal_entry_submit"
                        aria-label="Submit journal entry"
                        type="submit"
                        class="btn btn-default btn-sm disabled"
                        onclick="submitJournalEntry()"
                >
                  Submit (Control ⏎)
                </button>
                <button type="button"
                        class="journal-submit-caret btn btn-default btn-sm dropdown-toggle dropdown-toggle-split"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-label="Submit options">
                  <span class="visually-hidden">Submit options</span>
                </button>
                <ul class="dropdown-menu">
                  <li><button type="button" class="dropdown-item journal-submit-mode" data-mode="ctrl">Submit on Control ⏎</button></li>
                  <li><button type="button" class="dropdown-item journal-submit-mode" data-mode="enter">Submit on Enter</button></li>
                </ul>
              </div>
              <!-- File attachment -->
              <label class="input-group-text hidden" for="attach_file_input">Attach file</label>
              <input type="file" class="form-control hidden" id="attach_file_input" name="filename" onchange="attachFile();" />
              <input
                      id="attach_file"
                      type="button"
                      class="btn btn-default btn-sm btn-block btn-secondary my-1 form-control-lite no-print hidden"
                      value="Attach file"
                      onclick="document.getElementById('attach_file_input').click();"
               />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

@Footer(versionName, versionRef)
</div>
</body>
</html>
}
