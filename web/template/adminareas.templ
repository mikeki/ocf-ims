package template

templ AdminAreas(deployment, versionName, versionRef, eventName string) {
<!DOCTYPE html>
<html lang="en">
@Head("Event Areas", "admin_areas.js", false, false, versionRef)

<body>
<div class="container-fluid">
@Header(deployment)
@Nav(eventName)
<h1 id="doc-title">Event Areas</h1>
@LoadingOverlay()
@ErrorInfo()

  <!-- OCF reference maps (6o): handy when naming or checking areas. Year-stamped
       PDFs, hard-coded for now; they open in a new tab. -->
  <div class="mb-3 d-flex flex-wrap gap-2 no-print" id="area_maps">
    <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener"
       href="https://oregoncountryfair.net/wp-content/uploads/2024/03/2024-operations-map.pdf">
      <svg class="bi" fill="currentColor"><use href="#box-arrow-up-right"></use></svg>
      Operations map
    </a>
    <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener"
       href="https://www.oregoncountryfair.org/wp-content/uploads/2024/07/2024-PeachPit-Map.pdf">
      <svg class="bi" fill="currentColor"><use href="#box-arrow-up-right"></use></svg>
      Peach Pit map
    </a>
  </div>

    <div class="modal no-print" id="editAreaModal" tabindex="-1" aria-labelledby="editAreaModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <p class="modal-title fs-5" id="editAreaModalLabel">Edit Area</p>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
          </div>
          <div class="modal-body row">
            <div class="input-group mb-3">
              <label for="edit_area_name" class="control-label input-group-text">Name</label>
              <input id="edit_area_name" type="text" class="form-control form-control-sm" onchange="setAreaName(this);" />
            </div>
            <div class="input-group mb-3">
              <label for="edit_area_parent" class="control-label input-group-text">Parent</label>
              <select id="edit_area_parent" class="form-control form-select form-select-sm" onchange="setAreaParent(this);">
                <option value="">(top level)</option>
              </select>
            </div>
            <div class="input-group mb-3">
              <label for="edit_area_sort_order" class="control-label input-group-text">Sort order</label>
              <input id="edit_area_sort_order" type="number" class="form-control form-control-sm" onchange="setAreaSortOrder(this);" />
            </div>
            <div class="form-text">The slug is generated from the name when an area is created and never changes, so renaming is safe.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="modal no-print" id="markDuplicateModal" tabindex="-1" aria-labelledby="markDuplicateModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <p class="modal-title fs-5" id="markDuplicateModalLabel">Mark as duplicate</p>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
          </div>
          <div class="modal-body row">
            <p class="small">
              Re-points every incident using <span id="mark_duplicate_name" class="fw-semibold"></span>
              to the area you choose, then removes the duplicate. This can't be undone.
            </p>
            <div class="input-group mb-1">
              <label for="mark_duplicate_canonical" class="control-label input-group-text">Duplicate of</label>
              <select id="mark_duplicate_canonical" class="form-control form-select form-select-sm">
                <option value="">Select an area…</option>
              </select>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-danger" id="mark_duplicate_submit" onclick="submitMarkDuplicate()">Mark duplicate</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal no-print" id="addAreaModal" tabindex="-1" aria-labelledby="addAreaModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <p class="modal-title fs-5" id="addAreaModalLabel">New Area</p>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
          </div>
          <div class="modal-body row">
            <div class="input-group mb-3">
              <label for="add_area_name" class="control-label input-group-text">Name</label>
              <input id="add_area_name" type="text" class="form-control form-control-sm" placeholder="Chela Mela" />
            </div>
            <div class="input-group mb-3">
              <label for="add_area_parent" class="control-label input-group-text">Parent</label>
              <select id="add_area_parent" class="form-control form-select form-select-sm">
                <option value="">(top level)</option>
              </select>
            </div>
            <div class="input-group mb-3">
              <label for="add_area_sort_order" class="control-label input-group-text">Sort order</label>
              <input id="add_area_sort_order" type="number" class="form-control form-control-sm" value="0" />
            </div>
            <div class="form-text">The slug is generated from the name when the area is created and never changes.</div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="add_area_submit" onclick="submitCreateArea()">Add area</button>
          </div>
        </div>
      </div>
    </div>

  <div class="mb-3">
    <label for="event-name" class="form-label">Event</label>
    <select id="event-name" class="form-select auto-width" onchange="loadAreas();">
      <option value="">Select an event…</option>
    </select>
  </div>

  <div class="row hidden" id="areas_container">
    <div id="areas" class="col-sm-12 areas">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <label>Areas</label>
          <button type="button" class="btn btn-sm btn-success" id="add_area_button" onclick="showAddAreaModal()">New area</button>
        </div>
        <ul class="list-group list-group-small list-group-flush card-body">
          <template id="area_li_template">
            <li class="list-group-item ps-3" data-area-slug="">
              <span class="float-end">
                <button class="mark-duplicate-area badge btn btn-outline-secondary me-2 hidden">
                  Mark duplicate…
                </button>
                <button class="approve-area badge btn btn-success me-2 hidden">
                  Approve
                </button>
                <button class="show-edit-modal badge btn btn-primary me-2">
                  Edit
                </button>
              </span>
              <span class="area-name"></span>
              <span class="area-proposed badge text-bg-warning ms-2 hidden">proposed</span>
              <span class="area-slug text-body-secondary ms-2 font-monospace small"></span>
            </li>
          </template>
        </ul>
      </div>
    </div>
  </div>
@Footer(versionName, versionRef)
</div>
</body>
</html>

}
