package template

// QuickAddPersonModal is a reusable "add a new person" dialog for the
// search-first person comboboxes on the incident and visit pages. When a search
// finds no match, the combobox opens this modal (pre-filled with the typed text)
// so the user can supply a handle/email/wristband/participation before the person
// is created and attached — instead of the old silent name-only inline create.
// Wired in ims.ts (setupQuickAddPersonModal); IDs are namespaced "quick_add_person_*"
// to avoid colliding with the People page's own Add-Person modal.
templ QuickAddPersonModal() {
  <div class="modal no-print" id="quickAddPersonModal" tabindex="-1" aria-labelledby="quickAddPersonModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <p class="modal-title fs-5" id="quickAddPersonModalLabel">Create Person</p>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
        </div>
        <div class="modal-body">
          <p class="text-body-secondary small mb-3">This person isn't in the system yet — fill in their details to add them.</p>
          <!-- These identity/contact fields mirror the People page's Add-Person create
               form (web/template/people.templ) field-for-field so the two forms stay
               consistent; keep them in sync. Fair Name (the radio callsign) sits on
               top: it's what you typed to search and the identity most people are known
               by. openQuickAddPersonModal seeds it with the typed text; the access
               toggle relabels the fair name and email required. -->
          <div class="form-floating mb-2">
            <input id="quick_add_person_handle" type="text" class="form-control" autocomplete="off" placeholder="Fair Name" />
            <label id="quick_add_person_handle_label" for="quick_add_person_handle">Fair Name</label>
          </div>
          <div class="form-floating mb-2">
            <input id="quick_add_person_name" type="text" class="form-control" autocomplete="off" placeholder="Full Legal Name" />
            <label for="quick_add_person_name">Full Legal Name</label>
          </div>
          <!-- Email and phone are contact info, collectable for anyone at the fair
               (with or without a login). Email doubles as the login identifier when
               access is provided, so the access toggle relabels it required. -->
          <div class="form-floating mb-2">
            <input id="quick_add_person_email" type="email" class="form-control" autocomplete="off" placeholder="Email" />
            <label id="quick_add_person_email_label" for="quick_add_person_email">Email (optional)</label>
          </div>
          <div class="form-floating mb-2">
            <input id="quick_add_person_phone" type="tel" class="form-control" autocomplete="off" placeholder="Phone" />
            <label for="quick_add_person_phone">Phone (optional)</label>
          </div>
          <div class="form-text mb-3">A fair name or full legal name (plus optional email/phone) records someone at the fair as a contact. They get no login unless you add one below.</div>
          <!-- Access is opt-in: a person attached to an incident usually needs no login.
               The button reveals the credential fields and makes the fair name + email
               above required. -->
          <button type="button" class="btn btn-outline-primary w-100 mb-3" id="quick_add_person_access_toggle">
            Provide Access to IMS
          </button>
          <div id="quick_add_person_access_section" class="hidden">
            <div class="form-text mb-2">Signing in needs an email, a fair name (both above), and a password.</div>
            <div class="input-group mb-3">
              <div class="form-floating">
                <input id="quick_add_person_password" type="password" class="form-control" autocomplete="new-password" placeholder="Password" />
                <label for="quick_add_person_password">Password</label>
              </div>
              <button class="btn btn-outline-secondary" type="button" id="quick_add_person_password_toggle">Show</button>
            </div>
            <div class="input-group mb-3">
              <div class="form-floating">
                <input id="quick_add_person_password_confirm" type="password" class="form-control" autocomplete="new-password" placeholder="Confirm password" />
                <label for="quick_add_person_password_confirm">Confirm password</label>
              </div>
              <button class="btn btn-outline-secondary" type="button" id="quick_add_person_password_confirm_toggle">Show</button>
            </div>
          </div>
          <div id="quick_add_person_event_section" class="hidden mt-1">
            <hr class="my-3" />
            <p class="text-body-secondary small mb-2">At <strong id="quick_add_person_event_name"></strong></p>
            <div class="form-floating mb-3">
              <input id="quick_add_person_wristband" type="text" class="form-control" autocomplete="off" placeholder="Wristband" />
              <label for="quick_add_person_wristband">Wristband (optional)</label>
            </div>
            <div class="form-floating mb-3">
              <select id="quick_add_person_participation" class="form-select" aria-label="Role">
                <option value="">— none —</option>
                <option value="public">public</option>
                <option value="volunteer">volunteer</option>
              </select>
              <label for="quick_add_person_participation">Role</label>
            </div>
          </div>
          <div id="quick_add_person_error" class="text-danger small mt-2 hidden"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="quick_add_person_submit">Add person</button>
        </div>
      </div>
    </div>
  </div>
}
