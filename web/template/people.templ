package template

import "strconv"

templ People(deployment, versionName, versionRef, eventName string, defaultPasswordConfigured bool) {
<!DOCTYPE html>
<html lang="en">
@Head("Manage People", "people.js", false, false, versionRef)

<body>
<div class="container-fluid">
@Header(deployment)
@Nav(eventName)
<h1 id="doc-title">People</h1>
@LoadingOverlay()
@ErrorInfo()
<!-- Whether a shared default password is configured on the server (IMS_DEFAULT_PASSWORD).
     Read by people.ts to decide whether to offer the "use default password" choice. -->
<span id="default_password_configured" class="hidden" data-configured={ strconv.FormatBool(defaultPasswordConfigured) }></span>

    <div class="modal no-print" id="setPasswordModal" tabindex="-1" aria-labelledby="setPasswordModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <p class="modal-title fs-5" id="setPasswordModalLabel">Set Password</p>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
          </div>
          <div class="modal-body row">
            <p>Set a new password for <strong id="set_password_handle"></strong>.</p>
            <!-- When a shared default is configured it's the primary path (reset to
                 the default); "Set a specific password" reveals the fields below.
                 With no default configured this choice stays hidden and the fields
                 are always shown (people.ts). -->
            <div id="set_password_choice" class="hidden mb-2">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="setPasswordMode" id="set_password_mode_default" value="default" checked onchange="updateSetPasswordMode()" />
                <label class="form-check-label" for="set_password_mode_default">Reset to the shared default password</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="setPasswordMode" id="set_password_mode_specific" value="specific" onchange="updateSetPasswordMode()" />
                <label class="form-check-label" for="set_password_mode_specific">Set a specific password</label>
              </div>
            </div>
            <div id="set_password_fields">
              <div class="input-group mb-3">
                <div class="form-floating">
                  <input id="set_password_input" type="password" class="form-control" autocomplete="new-password" placeholder="New password" />
                  <label for="set_password_input">New password</label>
                </div>
                <button class="btn btn-outline-secondary" type="button" id="set_password_toggle">Show</button>
              </div>
              <div class="input-group mb-3">
                <div class="form-floating">
                  <input id="set_password_confirm" type="password" class="form-control" autocomplete="new-password" placeholder="Confirm password" />
                  <label for="set_password_confirm">Confirm password</label>
                </div>
                <button class="btn btn-outline-secondary" type="button" id="set_password_confirm_toggle">Show</button>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="set_password_submit" onclick="submitSetPassword()">Set password</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal no-print" id="addPersonModal" tabindex="-1" aria-labelledby="addPersonModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <p class="modal-title fs-5" id="addPersonModalLabel">Add Person</p>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
          </div>
          <div class="modal-body">
            <!-- Step 1 — find someone already in the registry to add to this event.
                 Only meaningful with an event selected; people.ts starts here when one
                 is, and skips straight to the create form (step 2) otherwise. -->
            <div id="add_person_search_section" class="hidden">
              <label for="add_person_search" class="form-label fw-semibold">Search existing people</label>
              <div class="position-relative">
                <input id="add_person_search" type="search" class="form-control" autocomplete="off" placeholder="Legal name or fair name…" />
                <div id="add_person_search_results"
                     class="list-group position-absolute w-100 shadow-sm hidden"
                     style="z-index: 1100; max-height: 16rem; overflow-y: auto;"></div>
              </div>
              <div class="form-text">Pick a match to add them to <strong id="add_person_search_event"></strong>.</div>
              <hr class="my-3" />
              <p class="text-body-secondary small mb-2">Not in the system yet?</p>
              <button type="button" class="btn btn-outline-success w-100" id="add_person_show_create" onclick="showCreatePersonForm()">
                Create a new person
              </button>
            </div>

            <!-- Step 2 — create a brand-new person. -->
            <div id="add_person_create_section" class="hidden">
              <button type="button" class="btn btn-sm btn-link px-0 mb-1 hidden" id="add_person_back_to_search" onclick="backToPersonSearch()">
                ← Back to search
              </button>
              <!-- Fair Name (the radio callsign) sits on top: it's the primary
                   identity most people are known by. Either a fair name or a full
                   legal name is enough to record someone; toggleProvideAccess()
                   relabels this field required once IMS access is turned on. -->
              <div class="form-floating mb-2">
                <input id="add_person_handle" type="text" class="form-control" autocomplete="off" placeholder="Fair Name" />
                <label id="add_person_handle_label" for="add_person_handle">Fair Name</label>
              </div>
              <div class="form-floating mb-2">
                <input id="add_person_name" type="text" class="form-control" autocomplete="off" placeholder="Full Legal Name" />
                <label for="add_person_name">Full Legal Name</label>
              </div>
              <!-- Email and phone are contact info, collectable for anyone at the fair
                   (with or without a login). Email doubles as the login identifier when
                   access is provided, so toggleProvideAccess() relabels it required. -->
              <div class="form-floating mb-2">
                <input id="add_person_email" type="email" class="form-control" autocomplete="off" placeholder="Email" />
                <label id="add_person_email_label" for="add_person_email">Email (optional)</label>
              </div>
              <div class="form-floating mb-2">
                <input id="add_person_phone" type="tel" class="form-control" autocomplete="off" placeholder="Phone" />
                <label for="add_person_phone">Phone (optional)</label>
              </div>
              <div class="form-text mb-3">A fair name or full legal name (plus optional email/phone) records someone at the fair as a contact. They get no login unless you add one below.</div>

              <!-- Access is opt-in: only staff who actually sign in to the IMS need an
                   account. The button reveals the credential fields; a handle and the
                   email above are required so we never mint a password no one can use. -->
              <button type="button" class="btn btn-outline-primary w-100 mb-3" id="add_person_access_toggle" onclick="toggleProvideAccess()">
                Provide Access to IMS
              </button>
              <div id="add_person_access_section" class="hidden">
                <div class="form-text mb-2">Signing in needs an email, a fair name (both above), and a password.</div>
                <!-- Password choice. When a shared default password is configured it is
                     the primary path (fast onboarding — the person signs in with it and
                     changes it later); "Set a specific password" reveals the fields.
                     With no default configured this choice stays hidden and the fields
                     are always shown (people.ts). -->
                <div id="add_person_pw_choice" class="hidden mb-2">
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="addPersonPwMode" id="add_person_pw_default" value="default" checked onchange="updateAddPasswordMode()" />
                    <label class="form-check-label" for="add_person_pw_default">Use the shared default password</label>
                    <div class="form-text mt-0">They sign in with this server's default password, then change it (or an admin resets it) later.</div>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="addPersonPwMode" id="add_person_pw_specific" value="specific" onchange="updateAddPasswordMode()" />
                    <label class="form-check-label" for="add_person_pw_specific">Set a specific password</label>
                  </div>
                </div>
                <div id="add_person_password_fields">
                  <div class="input-group mb-3">
                    <div class="form-floating">
                      <input id="add_person_password" type="password" class="form-control" autocomplete="new-password" placeholder="Password" />
                      <label for="add_person_password">Password</label>
                    </div>
                    <button class="btn btn-outline-secondary" type="button" id="add_person_password_toggle">Show</button>
                  </div>
                  <div class="input-group mb-3">
                    <div class="form-floating">
                      <input id="add_person_password_confirm" type="password" class="form-control" autocomplete="new-password" placeholder="Confirm password" />
                      <label for="add_person_password_confirm">Confirm password</label>
                    </div>
                    <button class="btn btn-outline-secondary" type="button" id="add_person_password_confirm_toggle">Show</button>
                  </div>
                </div>
              </div>

              <div id="add_person_event_section" class="hidden mt-1">
                <hr class="my-3" />
                <p class="text-body-secondary small mb-2">At <strong id="add_person_event_name"></strong></p>
                <!-- Inviter mode (53d): a non-admin inviter adds people only as reporters,
                     so the role picker is hidden and this note shows instead. -->
                <p id="add_person_invite_note" class="text-body-secondary small mb-2 hidden">They'll be added as a <strong>reporter</strong> on this event.</p>
                <div id="add_person_participation_wrap" class="form-floating mb-3">
                  <select id="add_person_participation" class="form-select" aria-label="Role">
                    <option value="">— none —</option>
                    <option value="writer">FC/BUM (full access)</option>
                    <option value="crew_leader">crew leader (invite reporters)</option>
                    <option value="reporter">reporter (own reports)</option>
                    <option value="volunteer">volunteer</option>
                    <option value="public">public</option>
                    <option value="not_present">not present</option>
                    <option value="ejected">ejected</option>
                  </select>
                  <label for="add_person_participation">Role</label>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary hidden" id="add_person_submit" onclick="submitCreatePerson()">Add person</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal no-print" id="editPersonModal" tabindex="-1" aria-labelledby="editPersonModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <p class="modal-title fs-5" id="editPersonModalLabel">Edit Person</p>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
          </div>
          <div class="modal-body row">
            <div class="form-floating mb-3">
              <input id="edit_person_handle" type="text" class="form-control" autocomplete="off" placeholder="Fair Name" />
              <label for="edit_person_handle">Fair Name</label>
            </div>
            <div class="form-floating mb-3">
              <input id="edit_person_name" type="text" class="form-control" autocomplete="off" placeholder="Full Legal Name" />
              <label for="edit_person_name">Full Legal Name</label>
            </div>
            <div class="form-floating mb-3">
              <input id="edit_person_email" type="email" class="form-control" autocomplete="off" placeholder="Email" />
              <label for="edit_person_email">Email (login &amp; contact)</label>
            </div>
            <div class="form-floating mb-3">
              <input id="edit_person_phone" type="tel" class="form-control" autocomplete="off" placeholder="Phone" />
              <label for="edit_person_phone">Phone (contact)</label>
            </div>
            <!-- Profile picture: a preview of the current picture (hidden when none),
                 a file picker to set/replace it, and a Remove button (shown only when
                 a picture exists). The picture is uploaded separately from the JSON
                 save (multipart), on Save. -->
            <div class="mb-3">
              <label class="form-label mb-1" for="edit_person_picture">Profile picture</label>
              <div class="d-flex align-items-center gap-3">
                <img id="edit_person_picture_preview" alt="Current profile picture"
                     class="rounded img-fluid hidden" style="max-height: 4rem; object-fit: cover;" />
                <input id="edit_person_picture" type="file" accept="image/*" class="form-control" />
                <button type="button" id="edit_person_picture_remove"
                        class="btn btn-outline-danger btn-sm hidden" onclick="removePersonPicture()">Remove</button>
              </div>
            </div>
            <div id="edit_person_event_section" class="hidden mt-3">
              <hr />
              <p class="text-body-secondary small mb-2">Participation for <strong id="edit_person_event_name"></strong></p>
              <div class="form-floating mb-3">
                <select id="edit_person_participation" class="form-select" aria-label="Participation">
                  <option value="">— none —</option>
                  <option value="writer">FC/BUM (full access)</option>
                  <option value="crew_leader">crew leader (invite reporters)</option>
                  <option value="reporter">reporter (own reports)</option>
                  <option value="volunteer">volunteer</option>
                  <option value="public">public</option>
                  <option value="not_present">not present</option>
                  <option value="ejected">ejected</option>
                </select>
                <label for="edit_person_participation">Role</label>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="edit_person_submit" onclick="submitEditPerson()">Save</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal no-print" id="removeFromEventModal" tabindex="-1" aria-labelledby="removeFromEventModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <p class="modal-title fs-5" id="removeFromEventModalLabel">Remove from event</p>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
          </div>
          <div class="modal-body">
            <p>Remove <strong id="remove_person_label"></strong> from <strong id="remove_event_name"></strong>?</p>
            <p class="text-body-secondary small">
              The person stays in the registry, and any incidents or visits that reference
              them are untouched — only their participation in this event changes. Choose
              how to record it:
            </p>
            <div class="d-grid gap-2">
              <button type="button" class="btn btn-outline-secondary text-start" id="remove_mark_not_present" onclick="submitMarkParticipation('not_present')">
                <strong>Mark as not present</strong>
                <div class="small text-body-secondary">Known person, not participating this year. Kept on the roster, marked inactive.</div>
              </button>
              <button type="button" class="btn btn-outline-warning text-start" id="remove_mark_ejected" onclick="submitMarkParticipation('ejected')">
                <strong>Mark as ejected</strong>
                <div class="small text-body-secondary">Removed from the event (kicked out). Kept for the record.</div>
              </button>
              <button type="button" class="btn btn-outline-danger text-start" id="remove_delete" onclick="submitRemoveFromEvent()">
                <strong>Remove — added by mistake</strong>
                <div class="small text-body-secondary">Deletes their participation entirely, as if never added.</div>
              </button>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>

  <div class="row mb-3">
    <div id="event_picker_wrap" class="col-sm-6 col-md-4 mb-2">
      <label for="event-name" class="form-label">Event</label>
      <select id="event-name" class="form-select" onchange="changeEvent();">
        <option value="">— no event —</option>
      </select>
      <div class="form-text">Pick an event to show each person's participation and to edit them.</div>
    </div>
    <div class="col-sm-6 col-md-4 mb-2">
      <label for="people-search" class="form-label">Search</label>
      <input id="people-search" type="search" class="form-control" autocomplete="off" placeholder="Legal name or fair name" oninput="filterPeople();" />
    </div>
    <div class="col-sm-6 col-md-4 mb-2 align-self-end">
      <div id="show_all_people_wrap" class="form-check hidden">
        <input id="show-all-people" type="checkbox" class="form-check-input" onchange="changeShowAll();" />
        <label class="form-check-label" for="show-all-people">Show all people (not just this event's roster)</label>
      </div>
    </div>
  </div>

  <div class="row" id="people_container">
    <div id="people" class="col-sm-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <label>People</label>
          <button type="button" class="btn btn-sm btn-success" id="add_person_button" onclick="showAddPersonModal()">Add person</button>
        </div>
        <!-- A roster table (slice 53c) replaces the old flat list-group: one column
             per attribute keeps a long roster scannable, and every per-row action
             collapses into a single ⋯ kebab menu so the row isn't a wall of buttons.
             The Role column only carries data when an event is selected. -->
        <div class="table-responsive">
          <table class="table table-sm table-striped table-hover align-middle mb-0">
            <thead>
              <tr>
                <!-- One combined column: "Fair Name (Legal Name)" is unambiguous, so
                     the roster no longer needs separate Legal Name / Fair Name columns. -->
                <th scope="col">Name</th>
                <th scope="col">Role</th>
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <!-- Two groups: people who can sign in to the IMS (top) and name-only
                 people tracked at the fair (below). people.ts fills each, prefixed
                 by a section-header row, and sorts each group by role. -->
            <tbody id="people_with_access"></tbody>
            <tbody id="people_without_access"></tbody>
          </table>
        </div>
        <template id="person_row_template">
          <tr data-person-id="">
            <td>
              <span class="person-name"></span>
              <!-- Admin marker: shown by people.ts when the person is a global admin.
                   An icon (the word "admin" now lives in the Role column, 6n).
                   is_admin is only present for admin viewers, so a non-admin inviter
                   never sees it. -->
              <span class="person-admin-badge ms-1 hidden" title="Admin">
                <svg class="bi" fill="currentColor" role="img" aria-label="Admin"><use href="#shield-lock-fill"></use></svg>
              </span>
            </td>
            <td>
              <!-- The role badge is a click-to-open menu (slice 52e): one click changes
                   a person's per-event role inline, instead of the Edit-Person modal.
                   The button text + menu are filled in by people.ts per row. -->
              <span class="person-participation-dropdown dropdown hidden">
                <button type="button" class="person-participation badge text-bg-light dropdown-toggle border-0" data-bs-toggle="dropdown" aria-expanded="false" title="Change role"></button>
                <ul class="person-participation-menu dropdown-menu"></ul>
              </span>
            </td>
            <td class="text-end">
              <!-- Per-row actions kebab. people.ts shows/hides individual items per row
                   (e.g. login-only actions for handle-less people; "Remove from event"
                   only for someone on the selected event's roster). -->
              <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-secondary border-0 person-actions-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">⋯</button>
                <ul class="person-actions dropdown-menu dropdown-menu-end">
                  <li><button type="button" class="dropdown-item show-edit-modal">Edit</button></li>
                  <li><button type="button" class="dropdown-item show-set-password-modal">Set password</button></li>
                  <li><button type="button" class="dropdown-item toggle-admin">Admin</button></li>
                  <li class="show-remove-divider hidden"><hr class="dropdown-divider"/></li>
                  <li><button type="button" class="dropdown-item text-danger show-remove-modal hidden">Remove from event</button></li>
                </ul>
              </div>
            </td>
          </tr>
        </template>
      </div>
    </div>
  </div>
@Footer(versionName, versionRef)
</div>
</body>
</html>

}
