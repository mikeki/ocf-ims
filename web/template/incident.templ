package template

templ Incident(deployment, versionName, versionRef, eventName string) {
<!DOCTYPE html>
<html lang="en">
@Head("Incident Details | " + eventName, "incident.js", true, false, versionRef)

<body>
<div class="container-fluid">
@Header(deployment)
@Nav(eventName)

@LoadingOverlay()

@ErrorInfo()

@QuickAddPersonModal()

@PersonProfileModal()

    <!-- Help modal for incident page -->
    <div class="modal no-print" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <p class="modal-title fs-5" id="helpModalLabel">Keyboard shortcuts</p>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
          </div>
          <div class="modal-body">
            <code>n</code>: create (n)ew Incident <br/>
            <code>a</code>: jump to (a)dd new journal text<br/>
            <code>h</code>: toggle showing system-generated (h)istory <br/>
          </div>
        </div>
      </div>
    </div>

    <!-- Incident type info -->
    <div class="modal no-print" id="incidentTypeInfoModal" tabindex="-1" aria-labelledby="incidentTypeInfoModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <p class="modal-title fs-5" id="incidentTypeInfoModalLabel">Incident Types</p>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" />
          </div>
          <div class="modal-body">
            <ul id="incident-type-info" class="list-group list-group-small" style="white-space: pre-wrap;">
              <template id="incident-type-info-template">
                <li class="list-group-item">
                  <div class="type-name"></div>
                  <div class="type-description ms-3 text-body-secondary"></div>
                </li>
              </template>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Incident number, state, started -->

    <div class="row py-1">
      <div class="col-sm-2 py-1">
        <div class="input-group flex-nowrap">
          <label for="incident_number" class="control-label input-group-text">IMS #</label>
          <input id="incident_number" type="text" class="form-control form-control-static mw-4rem" readonly/>
        </div>
      </div>
      <div class="col-sm-4 py-1">
        <div class="input-group">
          <label for="incident_state" class="control-label input-group-text">State</label>
          <select
                  id="incident_state"
                  class="form-control form-select form-select-sm auto-width"
                  onchange="editState()"
          >
            <option value="new">New</option>
            <option value="on_hold">On Hold</option>
            <option value="dispatched">Dispatched</option>
            <option value="on_scene">On Scene</option>
            <option value="closed">Closed</option>
          </select>
        </div>
      </div>
      <div class="col-sm-6 py-1">
        <div class="input-group">
          <!-- This label will be applied to the altInput, which is created in the JS by Flatpickr. -->
          <label class="control-label input-group-text" for="alt_started_datetime">Started</label>
          <input id="started_datetime" type="text" class="form-control" />
          <span id="started_datetime_tz" class="control-follow-text input-group-text"
              title="This datetime must be edited in your computer's local time zone."
          ></span>
        </div>
      </div>
    </div>

    <!-- Outcome (disposition; orthogonal to state) -->

    <div class="row py-1">
      <div class="col-sm-6 py-1">
        <div class="input-group">
          <label for="incident_outcome" class="control-label input-group-text">Outcome</label>
          <select
                  id="incident_outcome"
                  class="form-control form-select form-select-sm auto-width"
                  onchange="editOutcome()"
          >
            <option value="">(none)</option>
            <option value="information_only">Information Only</option>
            <option value="resolved_on_scene">Resolved On Scene</option>
            <option value="referred_to_coordinator">Referred to Coordinator</option>
            <option value="referred_to_management">Referred to Management</option>
            <option value="referred_to_community_support">Referred to Community Support</option>
            <option value="referred_to_mediation">Referred to Mediation</option>
            <option value="follow_up_required">Follow-Up Required</option>
            <option value="no_action_needed">No Action Needed</option>
            <option value="taken_to_big_bird">Taken to Big Bird</option>
            <option value="taken_to_little_wing">Taken to Little Wing</option>
            <option value="asked_to_leave">Asked to Leave</option>
            <option value="booted">Booted</option>
            <option value="arrested">Arrested</option>
            <option value="transported_in_ambulance">Transported in Ambulance</option>
          </select>
        </div>
      </div>
      <div class="col-sm-6 py-1">
        <div class="input-group">
          <label for="incident_priority" class="control-label input-group-text">Priority</label>
          <select
                  id="incident_priority"
                  class="form-control form-select form-select-sm auto-width"
                  onchange="editPriority()"
          >
            <option value="5">High</option>
            <option value="3">Normal</option>
            <option value="1">Low</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Summary -->

    <div class="row">
      <div class="input-group">
        <label for="incident_summary" class="input-group-text control-label">
          Summary<span class="text-danger ms-1" title="Required field" aria-label="required">*</span>
        </label>
        <input
                id="incident_summary" class="form-control form-control-sm"
                type="text" inputmode="latin-prose" autocomplete="off"
                onchange="editIncidentSummary()"
        />
      </div>
    </div>

    <!-- Attached people, incident types -->

    <div class="row">
      <div class="col-sm-6 py-2">
        <div class="card">
          <label class="control-label card-header">
          People
          </label>
          <ul id="incident_people_list" class="list-group list-group-flush list-group-small card-body">
            <template id="incident_people_li_template">
              <li class="list-group-item flex-input-container incident-person-item ps-3 hidden">
                <span class="person-name"><a href="#" title="View profile"></a></span>
                <input aria-label="Description of involvement" type="text" class="form-control form-control-sm short-input involvement-input"
                    list="involvement_presets" placeholder="Involvement (e.g. Witness)" onchange="setPersonInvolvement(this)" maxlength="50"
                />
                <!-- 52f: grant this involved reporter read + journal-add access to
                     this incident. Revealed by incident.ts only for a writer editing
                     a user who lacks event-wide incident access. -->
                <label class="person-grant-access form-check-label small text-nowrap text-body-secondary ms-2 hidden" title="Let this reporter view this incident and add journal entries.">
                  <input type="checkbox" class="form-check-input me-1" onchange="setPersonGrant(this)" />incident access
                </label>
                <span class="person-has-access badge text-bg-light ms-2 hidden" title="Already has incident access via their role.">has access</span>
                <button class="badge btn btn-danger remove-badge float-end" onclick="removePerson(this)" tabindex="-1">
                  X
                </button>
              </li>
            </template>
          </ul>
          <!-- Suggested involvement roles for the per-person field above. A
               datalist is suggestions only: any free-text is still accepted. -->
          <datalist id="involvement_presets">
            <option value="Witness"></option>
            <option value="Reporting Party"></option>
            <option value="Subject"></option>
            <option value="Injured Party"></option>
            <option value="First Responder"></option>
            <option value="Staff"></option>
            <option value="Other"></option>
          </datalist>
          <div class="card-footer no-print">
            <div class="flex-input-container">
              <label for="person_add" class="control-label">Add:</label>
              <div class="position-relative auto-width">
                <input
                        type="text"
                        id="person_add"
                        aria-label="Add Person"
                        autocomplete="off"
                        placeholder="Search legal name, fair name, or wristband…"
                        class="form-control form-control-sm w-100"
                />
                <div id="person_add_results"
                     class="list-group position-absolute w-100 shadow-sm hidden"
                     style="z-index: 1000; max-height: 16rem; overflow-y: auto;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 py-2">
        <div class="card">
          <label class="control-label card-header">Incident Types<span class="text-danger ms-1" title="At least one is required" aria-label="required">*</span>
            <a href="#" class="link-body-emphasis float-end no-print" id="show-incident-type-info" title="Show Incident Type descriptions" tabindex="-1">
              Info
              <svg fill="currentColor" class="bi">
                <use href="#question-circle" />
              </svg>
            </a>
          </label>
          <div id="incident_types_required" class="small text-danger px-3 pt-2 hidden no-print">
            Add at least one incident type.
          </div>
          <ul id="incident_types_list" class="list-group list-group-flush list-group-small card-body">
            <template id="incident_types_li_template">
              <li class="list-group-item ps-3 hidden">
                <button class="badge btn btn-danger remove-badge float-end" onclick="removeIncidentType(this)">
                  X
                </button>
              </li>
            </template>
          </ul>
          <div class="card-footer no-print">
            <div class="flex-input-container">
              <label for="incident_type_add" class="control-label">Add:</label>
              <input
                      type="text"
                      id="incident_type_add"
                      aria-label="Add Incident Type"
                      list="incident_types"
                      autocomplete="off"
                      placeholder="Type or pick a type…"
                      class="form-control form-control-sm auto-width"
                      onchange="addIncidentType()"
              />
              <datalist id="incident_types">
                <option value=""/>
              </datalist>
            </div>
            <div id="incident_type_create" class="form-text no-print hidden">
              No incident type matches "<span id="incident_type_create_name"></span>".
              <button type="button" class="btn btn-sm btn-link p-0 align-baseline"
                      id="incident_type_create_btn"
                      onclick="proposeIncidentType()">
                Propose it for this event
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Location -->

    <div class="row py-1">
      <div class="col-sm-12">
        <div class="card">
          <label class="control-label card-header">Location</label>
          <div class="card-body">
            <form class="form-horizontal">
              <div class="input-group row align-items-center">
                <label for="incident_location_area"
                       class="col-sm-2 col-form-label control-label">Area:</label>
                <div class="col-sm-10">
                  <input
                          id="incident_location_area" class="form-control form-control-sm"
                          type="text" inputmode="latin-prose" autocomplete="off"
                          data-1p-ignore data-lpignore="true" data-bwignore
                          aria-label="Location area"
                          list="incident_location_areas"
                          placeholder="Type to search areas"
                          onchange="editLocationArea()"
                  />
                  <datalist id="incident_location_areas"></datalist>
                  <div id="incident_location_area_create" class="form-text no-print hidden">
                    No area matches "<span id="incident_location_area_create_name"></span>".
                    <button type="button" class="btn btn-sm btn-link p-0 align-baseline"
                            id="incident_location_area_create_btn"
                            onclick="createLocationArea()">
                      Create it for this event
                    </button>
                  </div>
                </div>
              </div>
              <div class="input-group row align-items-center">
                <label for="incident_location_booth"
                       class="col-sm-2 col-form-label control-label">Booth:</label>
                <div class="col-sm-10">
                  <input
                          id="incident_location_booth" class="form-control form-control-sm"
                          type="text" inputmode="latin-prose" autocomplete="off"
                          data-1p-ignore data-lpignore="true" data-bwignore
                          aria-label="Booth number"
                          placeholder="Booth number, if applicable"
                          maxlength="32"
                          onchange="editLocationBooth()"
                  />
                </div>
              </div>
              <div class="input-group row align-items-center">
                <label for="incident_location_description" class="col-sm-2 col-form-label control-label">Details:</label>
                <div class="col-sm-10">
                  <input
                          id="incident_location_description" class="form-control form-control-sm"
                          type="text" inputmode="latin-prose" autocomplete="off"
                          data-1p-ignore data-lpignore="true" data-bwignore
                          aria-label="Additional location description"
                          placeholder="Other identifying info"
                          onchange="editLocationDescription()"
                  />
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Incident details -->

    <div class="row">
      <div class="col-sm-12">
        <div class="card">
          <label class="control-label card-header">Entries from Incident and attached Reports</label>
          <div id="journal_entry_well" class="card-body">
            <div class="journal_filter_toggles no-print mb-1">
              <label class="control-label me-3">
                <input id="show_reports_checkbox" type="checkbox" checked onchange="applyJournalFilters()"/>
                Attached Reports
              </label>
              <label class="control-label me-3">
                <input id="show_history_checkbox" type="checkbox" onchange="applyJournalFilters()"/>
                Changes History
              </label>
              <label class="control-label me-3">
                <input id="show_stricken_checkbox" type="checkbox" onchange="applyJournalFilters()"/>
                Stricken
              </label>
            </div>
            <div id="journal_entries"></div>
          </div>
          <div class="card-footer">
            <div class="position-relative">
              <textarea
                      id="journal_entry_add"
                      aria-label="New journal entry text"
                      class="form-control no-print"
                      placeholder="Press &quot;a&quot; to add journal text. Type @ to mention someone."
                      onchange="journalEntryEdited()"
              ></textarea>
              <!-- @mention typeahead dropdown (plan 81); populated by ims.ts. -->
              <div id="journal_mention_results"
                   class="list-group position-absolute w-100 shadow hidden no-print"
                   style="z-index: 1080; max-height: 14rem; overflow-y: auto;"></div>
            </div>
            <span id="journal_draft_restored" class="text-body-secondary small hidden no-print">Unsaved draft restored.</span>
            <div class="d-flex justify-content-between">
              <div class="btn-group my-1 no-print" role="group">
                <button
                        id="journal_entry_submit"
                        aria-label="Submit journal entry"
                        type="submit"
                        class="btn btn-default btn-sm disabled"
                        onclick="submitJournalEntry()"
                >
                  Submit (Control ⏎)
                </button>
                <button type="button"
                        class="journal-submit-caret btn btn-default btn-sm dropdown-toggle dropdown-toggle-split"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-label="Submit options">
                  <span class="visually-hidden">Submit options</span>
                </button>
                <ul class="dropdown-menu">
                  <li><button type="button" class="dropdown-item journal-submit-mode" data-mode="ctrl">Submit on Control ⏎</button></li>
                  <li><button type="button" class="dropdown-item journal-submit-mode" data-mode="enter">Submit on Enter</button></li>
                </ul>
              </div>
              <!-- File attachment -->
              <label class="input-group-text hidden" for="attach_file_input">Attach file</label>
              <input type="file" class="form-control hidden" id="attach_file_input" name="filename" onchange="attachFile();" />
              <input
                      id="attach_file"
                      type="button"
                      class="btn btn-default btn-sm btn-block btn-secondary my-1 form-control-lite no-print hidden"
                      value="Attach file"
                      onclick="document.getElementById('attach_file_input').click();"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Attached reports, linked incidents -->

    <div class="row py-2">
      <div class="col-sm-6">
        <div class="card">
          <!-- White Bird Visits is disabled this year (see nav.templ / the
               visitsEnabled flag in incident.ts), so this widget links Reports
               only. Restore the "/Visits" wording when re-enabling. -->
          <label class="control-label card-header">Attached Reports</label>
          <div class="small text-body-secondary px-3 pt-2 no-print">
            Link existing Reports that relate to this incident.
          </div>
          <ul id="attached_reports" class="list-group list-group-small card-body list-group-flush">
            <template id="attached_report_li_template">
              <li class="list-group-item ps-3 hidden">
                <button class="badge btn btn-danger remove-badge float-end"
                        onclick="detachReport(this)">
                  X
                </button>
              </li>
            </template>
          </ul>
          <div id="attached_report_add_container" class="flex-input-container card-footer no-print">
            <label for="attached_report_add" class="control-label">Add:</label>
            <select
                    id="attached_report_add"
                    class="form-control form-control-sm"
                    onchange="attachReport()"
            >
              <option value=""/>
            </select>
          </div>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="card">
          <label class="control-label card-header">Linked Incidents</label>
          <div class="small text-body-secondary px-3 pt-2 no-print">
            Cross-link other incidents that are related to this one.
          </div>
          <ul id="linked_incidents" class="list-group list-group-small card-body list-group-flush">
            <li class="list-group-item ps-3 hidden">
              <button class="badge btn btn-danger remove-badge float-end"
                      onclick="unlinkIncident(this)">
                  X
              </button>
            </li>
          </ul>
          <div id="linked_incident_add_container" class="flex-input-container card-footer no-print">
            <label class="control-label" for="linked_incident_add">Link IMS #:</label>
            <input
                    id="linked_incident_add"
                    class="form-control form-control-sm"
                    onchange="linkIncident(this)"
                    autocomplete="off"
                    placeholder="1 or 3,4,5 or 2015#2"
                    type="text"
            />
          </div>
        </div>
      </div>
    </div>

@Footer(versionName, versionRef)
</div>
</body>
</html>
}
