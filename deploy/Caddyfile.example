# Example Caddy reverse-proxy config for the IMS host.
#
# Caddy and the IMS app share the external `web` Docker network (created with
# `docker network create web`), so Caddy reaches containers BY NAME — no host
# ports are published. Caddy auto-provisions HTTPS, which web-push/service-workers
# require. Replace the domains with your real ones.
#
# Merge the blocks below into your existing Caddyfile (you already run a Caddy
# with a hello-world site — drop the hello-world and add these).

# ---- The IMS app (public) -------------------------------------------------
# The app's login throttle (per-IP failed-attempt lockout) keys on the RIGHTMOST
# X-Forwarded-For entry — the hop Caddy appends here. Caddy's reverse_proxy sets
# that header by default, so this works as-is. Do NOT strip or overwrite
# X-Forwarded-For for this site, or the per-IP limit loses the real client IP.
# (This assumes Caddy is the sole proxy in front of the app; if you later add
# another proxy/CDN ahead of Caddy, revisit clientIPForRateLimit's one-hop
# assumption in api/ratelimit.go.)
ims.ocf.example.org {
	# HSTS belongs at the TLS terminator, and Caddy owns HTTPS here — so it's set
	# on this side, not in the app. It tells browsers to refuse plaintext HTTP to
	# this host for max-age seconds (~1 year). Enable it only once you're confident
	# the site is reliably HTTPS (Caddy auto-provisions certs, so it is). The app
	# already emits the content security headers (X-Content-Type-Options,
	# X-Frame-Options, Referrer-Policy, and a report-only Content-Security-Policy),
	# so don't duplicate those here.
	#
	# Do NOT add `preload` until you've verified everything and are ready to commit
	# to HTTPS-only permanently — preload is slow to undo.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	reverse_proxy ocf-ims:80
}

# ---- Monitoring (lock these down — they expose logs and metrics) ----------
# Generate a password hash with:  caddy hash-password
# Then put real bcrypt hashes below. Protect every monitoring tool.

(admins_only) {
	basic_auth {
		# username  bcrypt-hash-from-`caddy hash-password`
		ops $2a$14$REPLACE_WITH_A_REAL_BCRYPT_HASH
	}
}

status.ocf.example.org {
	import admins_only
	reverse_proxy uptime-kuma:3001
}

logs.ocf.example.org {
	import admins_only
	reverse_proxy dozzle:8080
}

metrics.ocf.example.org {
	import admins_only
	reverse_proxy beszel-hub:8090
}
