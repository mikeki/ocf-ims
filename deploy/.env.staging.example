# Staging environment for OCF IMS (plan 09m) — the testing instance.
#
#   cp deploy/.env.staging.example .env      # in the staging stack's OWN checkout
#   # then fill in the two secrets below
#
# This becomes the gitignored `.env` that docker-compose.staging.yml reads. Keep it
# out of git even though staging holds no real data: it signs the instance's tokens.

# ---- Secrets (generate fresh; keep stable so restarts don't log testers out) ----

# Signs access + refresh tokens. A non-dev deployment refuses to start without one
# of at least 32 characters. Generate once:
#   openssl rand -hex 32
IMS_JWT_SECRET=

# IMS database password (the app's "ims" user). Generate once:
#   openssl rand -hex 24
IMS_DB_PASSWORD=

# ---- Which build ----------------------------------------------------------------

# Staging follows master: `latest` is moved to every master build that passed CI,
# and deploy/staging-pull.sh (from cron) pulls it. Pin a commit SHA to freeze the
# instance for a test session; go back to latest afterwards.
IMAGE_TAG=latest

# ---- Data -----------------------------------------------------------------------

# `demo` loads store/fakeimsdb/seed.sql into an EMPTY database on boot (idempotent):
# the demo people, events and incidents. Every seeded login's password is its handle:
#   miguel@example.com / Miguel           (admin)
#   shadowdancer@example.com / ShadowDancer
#   teammember@example.com / TeamMember
# Those are public — never put real data on this instance. Reset to the seed with
#   docker compose -f docker-compose.staging.yml down -v && docker compose -f docker-compose.staging.yml up -d
IMS_SEED=demo

IMS_DB_DATABASE=ims
IMS_DB_USER_NAME=ims
IMS_LOG_LEVEL=DEBUG
# Refresh-token lifetime in seconds = felt session length (7 days).
IMS_TOKEN_LIFETIME=604800
# Access-token lifetime in seconds (15 min). Set 90 to watch the Expo client's
# proactive refresh (it fires 60 s before expiry) without waiting.
IMS_ACCESS_TOKEN_LIFETIME=900

# ---- Client work (plan 09i) -----------------------------------------------------

# Expo dev-server origins on a laptop that may call this instance cross-origin with
# credentials: Metro's web server (8081) and `expo serve` of the web export (8082,
# the Playwright tracer). Comma-separated EXACT origins — no path, no wildcard; the
# server refuses to start on a malformed entry.
#
# Know the limit: the web client's refresh cookie is SameSite=Strict, so a browser
# on localhost is cross-site to staging and gets sign-in + reads but no refresh and
# no reload-resume. The hosted web build (same origin, 09m step 2) and the native
# client (body-carried refresh token) are unaffected.
IMS_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082

# Shared onboarding password (8–256 characters). When set, an admin granting IMS
# access without typing a password gives the person this one, and a user signed in
# with it is prompted to choose their own — the forced-password-change flow the
# client's login screen implements. Leave unset to keep the feature off.
# IMS_DEFAULT_PASSWORD=changeme123!

# ---- Attachments (local volume) -------------------------------------------------
IMS_ATTACHMENTS_STORE=local

# ---- Reverse proxy network --------------------------------------------------------
# The external Docker network Caddy shares with the app: `web` on the production
# host (docs/deployment.md); the demo host calls it `maybloom-proxy`.
# PROXY_NETWORK=web
