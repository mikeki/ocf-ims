# Production environment for OCF IMS.
#
#   cp deploy/.env.prod.example .env      # at the repo root, on the host
#   # then fill in the secrets below
#
# This file becomes the gitignored `.env` that docker-compose.prod.yml reads.
# NEVER commit the filled-in version — it holds signing keys and DB credentials.

# ---- Secrets (generate fresh, keep stable) --------------------------------

# Signs access + refresh tokens. MUST be stable across restarts, or every reboot
# logs everyone out. Generate ONCE and never change it during the event:
#   openssl rand -hex 32
IMS_JWT_SECRET=

# IMS database password (the app's "ims" user). Generate once:
#   openssl rand -hex 24
IMS_DB_PASSWORD=

# ---- Deployment knobs (sane prod defaults; override if needed) -------------

# Which GHCR image tag to run (built + pushed by publish-image.yml). Leave at
# `latest` for the rolling master build, or pin to a commit SHA for a controlled
# rollout / easy rollback, e.g. IMAGE_TAG=<40-char-sha>.
# IMAGE_TAG=latest

IMS_DB_DATABASE=ims
IMS_DB_USER_NAME=ims
IMS_LOG_LEVEL=INFO
# Refresh-token lifetime in seconds = felt session length (7 days).
IMS_TOKEN_LIFETIME=604800

# ---- Attachments (local volume) -------------------------------------------
# Stored on the `ims-attachments` named volume (see docker-compose.prod.yml).
# Included by deploy/backup-db.sh? NO — that script backs up the DB only; the
# attachments volume is backed up separately (see the runbook).
IMS_ATTACHMENTS_STORE=local

# To use S3 instead, set IMS_ATTACHMENTS_STORE=s3 and uncomment:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# IMS_ATTACHMENTS_S3_BUCKET=
# IMS_ATTACHMENTS_S3_COMMON_KEY_PREFIX=ims-attachments/

# ---- Web push (optional; requires HTTPS, which Caddy provides) -------------
# Generate a VAPID key pair once. All three or none. Private key is a SECRET.
# IMS_VAPID_PUBLIC=
# IMS_VAPID_PRIVATE=
# IMS_VAPID_SUBJECT=mailto:ims@ocf.example.org

# ---- Monitoring -----------------------------------------------------------
# Beszel agent key — paste from the beszel-hub UI after first boot (see
# docker-compose.monitoring.yml).
# BESZEL_KEY=
